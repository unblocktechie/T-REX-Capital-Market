# Which network the scripts target — "arcTestnet" (default) or "sepolia".
# See scripts/network-config.ts.
NETWORK=arcTestnet

# --- Arc Testnet (chainId 5042002; native gas token is USDC, not ETH) ---
ARC_TESTNET_RPC_URL=
# Blockscout-style API key for arcscan verification — any non-empty string
# generally works. Optional.
ARCSCAN_API_KEY=

# --- Sepolia (kept for rollback / comparison) ---
SEPOLIA_RPC_URL=
# Free API key from https://etherscan.io/myapikey — used only by `hardhat verify`.
ETHERSCAN_API_KEY=

DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- Issuer suite deployment (phase0-02-deploy-issuer-suite.ts) ---
ISSUER_ADDRESS=
ISSUER_PRIVATE_KEY=

# --- TREXPlatformController (deploy-platform-controller.ts / wire-platform-controller.ts) ---
# Stablecoin contract address the platform pays out / collects in. On Arc
# Testnet this can be Arc's native USDC ERC-20 interface (fixed system
# address) or a mock stablecoin you deploy yourself.
PAYMENT_TOKEN_ADDRESS=
# Optional: platform controller owner, defaults to DEPLOYER_PRIVATE_KEY's address.
PLATFORM_OWNER_ADDRESS=
# Only needed when running wire-platform-controller.ts for a specific token.
TOKEN_ADDRESS=
INITIAL_PRICE=
