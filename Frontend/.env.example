VITE_APP_NAME=T-REX Capital Market
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://192.168.29.90:3000/api
VITE_API_VERSION=v1
VITE_SOCKET_URL=ws://192.168.29.90:3000/ws
VITE_REQUEST_TIMEOUT=15000
VITE_USE_MOCK_API=false
VITE_ENABLE_DARK_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SOURCEMAPS=false
VITE_FIREBASE_API_KEY=
VITE_SENTRY_DSN=
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# Privy authentication + embedded wallet configuration
# App ID is public and is used by the browser SDK. Client ID is optional.
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_PRIVY_CLIENT_ID=
# Enable "Return user data in an identity token" in Privy Dashboard -> User management -> Authentication -> Advanced.

# Privy embedded wallets are restricted to Arc Testnet for the current platform.
VITE_WEB3_DEFAULT_CHAIN=arc-testnet
VITE_WEB3_ENABLED_CHAINS=arc-testnet
VITE_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Arc Testnet T-REX deployment contracts
VITE_TREX_GATEWAY_ADDRESS=0x9b0077e6000C9937eE769A61519F9CdFc3f30331
# This platform wallet is always included as a Token Agent so the platform can
# perform approved token operations, such as minting on behalf of the issuer.
VITE_TREX_PLATFORM_WALLET_ADDRESS=0x849F887daec1B14c161ec377C95549ef83dDf3ff
VITE_TREX_PLATFORM_CONTROLLER_ADDRESS=0x972E9CEf9eA9d3A9d7f3261bb8e16bA59E76a0FB
# Arc's USDC ERC-20 interface. Arc also uses USDC as its native gas asset.
VITE_TREX_PAYMENT_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
VITE_ONCHAIN_ID_FACTORY_ADDRESS=0xA30A9FC6d6ea2Fa3fa3F01265a3C1253125481D8
VITE_COUNTRY_RESTRICT_MODULE_ADDRESS=0x7f3a67C7b520a0F01d7A3d98A5B7F2a3bfc7A54D
VITE_MAX_BALANCE_MODULE_ADDRESS=0x08B942c8aCFdB143F0096Cc4D80160221B589804
VITE_MAX_INVESTORS_MODULE_ADDRESS=0xa893BFEE2eCd38A61De91D74Ec15427dA6f7890f

# Never put deployer or issuer private keys in a VITE_* variable or frontend source.
# The issuer signs deployment transactions through the authenticated Privy embedded wallet.
