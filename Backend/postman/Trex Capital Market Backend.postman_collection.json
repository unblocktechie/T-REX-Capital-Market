    {
      "name": "Organization Onboarding",
      "description": "Run Organization Options, Countries, States, and Cities first. Run User Login with a verified issuer account to populate userToken. Draft saves allow partial data; completed step saves and final submission enforce the full validation rules.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Organization Options",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization-options"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Organization options are returned', () => pm.response.to.have.status(200));",
            "const data = pm.response.json().data;",
            "if (data.entityTypes.length) pm.collectionVariables.set('entityTypeUid', data.entityTypes[0].entityTypeUid);",
            "if (data.industries.length) pm.collectionVariables.set('industryUid', data.industries[0].industryUid);",
            "const required = data.documentTypes.find((item) => item.isRequired);",
            "if (required) pm.collectionVariables.set('documentTypeUid', required.documentTypeUid);"
          ] } }]
        },
        {
          "name": "List Countries",
