VITE_APP_NAME=T-REX Capital Market
VITE_APP_VERSION=1.0.0
VITE_DEPLOYMENT_ENVIRONMENT=testnet
VITE_COMPANY_NAME=T-REX Capital Market
VITE_COMPANY_WEBSITE_URL=https://unblocktechnolabs.com/
VITE_COMPANY_WEBSITE_LABEL=UNBLOCK TECHNOLABS
VITE_CONTACT_US_URL=https://t-rex.capital/contact-us
VITE_DOCUMENTS_URL=https://t-rex-capital.gitbook.io/docs/
VITE_SUPPORT_EMAIL=a@a.com
VITE_API_BASE_URL=http://192.168.29.90:3000/api
VITE_API_VERSION=v1
VITE_SOCKET_URL=ws://192.168.29.90:3000/ws
VITE_REQUEST_TIMEOUT=500000
VITE_USE_MOCK_API=false
VITE_ENABLE_DARK_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SOURCEMAPS=false
VITE_FIREBASE_API_KEY=
VITE_SENTRY_DSN=
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_WALLETCONNECT_PROJECT_ID=

# Supported networks come from GET /api/v1/chains. Browser-safe runtime metadata,
# deployment contracts, compliance modules, confirmations, and platform payment tokens come
# from GET /api/v1/chains/{chainUid}/config. Keep platform-chain addresses out of VITE_*.
# The bridge-only Ethereum exception below is not a platform investment network.

# Wallet Management / Circle Bridge only. This is intentionally separate from
# platform-supported chains returned by the backend. Use Ethereum mainnet values
# in the mainnet profile and Ethereum Sepolia values in the testnet profile.
VITE_BRIDGE_ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BRIDGE_ETHEREUM_EXPLORER_URL=https://sepolia.etherscan.io
VITE_BRIDGE_ETHEREUM_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
