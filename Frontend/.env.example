# Circle bridge
VITE_BRIDGE_ENVIRONMENT=testnet
VITE_BRIDGE_TOKEN=USDC
VITE_BRIDGE_TRANSFER_SPEED=FAST
VITE_BRIDGE_MAX_FEE=
VITE_BRIDGE_FALLBACK_SOURCE_GAS_UNITS=500000
VITE_BRIDGE_FALLBACK_DESTINATION_GAS_UNITS=500000
VITE_BRIDGE_SOURCE_APP_KIT_CHAIN=Ethereum_Sepolia
VITE_BRIDGE_DESTINATION_APP_KIT_CHAIN=Arc_Testnet
VITE_BRIDGE_TO_ARC_LABEL=Bridge to Arc
VITE_BRIDGE_TO_WALLET_VIEW_LABEL=Bridge to Sepolia

