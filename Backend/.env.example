NODE_ENV=development
PORT=3000
APP_NAME=T-REX Capital Market Backend
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trexCapitalMarket
DB_USER=root
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY=1h
ISSUER_ROLE_UID=00000000-0000-4000-8000-000000000003
INVESTOR_ROLE_UID=00000000-0000-4000-8000-000000000004
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Privy server credentials (Dashboard -> App settings). Never expose PRIVY_APP_SECRET to the frontend.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM_NAME=T-REX Capital Market
SMTP_FROM_EMAIL=no-reply@example.com

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false

LOG_LEVEL=debug
LOG_RETENTION_DAYS=30

UPLOAD_DIR=storage/organization-documents
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=10

# Investor onboarding document storage (KYC + accreditation documents).
INVESTOR_UPLOAD_DIR=storage/investor-documents
INVESTOR_UPLOAD_MAX_FILE_SIZE_MB=10
INVESTOR_UPLOAD_MAX_FILES=10

TOKEN_IMAGE_UPLOAD_DIR=storage/token-images
TOKEN_IMAGE_MAX_FILE_SIZE_MB=2
TOKEN_IMAGE_MIN_DIMENSION=256
TOKEN_IMAGE_MAX_DIMENSION=4096
TOKEN_IMAGE_OPTIMIZED_MAX_DIMENSION=1024
# Optional production ClamAV executable, for example /usr/bin/clamscan
TOKEN_IMAGE_VIRUS_SCANNER_PATH=
TOKEN_IMAGE_VIRUS_SCAN_TIMEOUT_MS=30000

# Sepolia OnchainID factory configuration. Never commit a real deployer private key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_FALLBACK_RPC_URLS=https://sepolia.gateway.tenderly.co
IDENTITY_FACTORY_ADDRESS=0xe1da45b88C9d3f4347A6E1C6e8ee63e360068a15
TREX_FACTORY_ADDRESS=replace-with-the-sepolia-trex-factory-address
DEPLOYER_PRIVATE_KEY=replace-with-a-new-rotated-private-key
DEPLOYER_ADDRESS=replace-with-the-address-derived-from-the-private-key
# Backend-authoritative Token Agent for every newly created TREX token.
PLATFORM_CONTROLLER_ADDRESS=0x40e81FAA4e6D54ae0632DF146939bB5858359271
BLOCKCHAIN_CONFIRMATIONS=2
REGISTRY_CONFIRMATIONS=2
# Comma-separated allowlist for wallet executors that may wrap registerIdentity. The nested target,
# value, function and arguments are still independently decoded and verified by the backend.
REGISTRY_DELEGATION_MANAGER_ADDRESSES=0xdb9B1e94B5b69Df7e401DDbedE43491141047dB3
TRANSACTION_DELEGATION_MANAGER_ADDRESSES=0xdb9B1e94B5b69Df7e401DDbedE43491141047dB3
REGISTRY_RECOVERY_LOOKBACK_BLOCKS=200000
REGISTRY_RECOVERY_BLOCK_OFFSET=20000
REGISTRY_RPC_EVIDENCE_ATTEMPTS=5
BLOCKCHAIN_TRANSACTION_TIMEOUT_MS=120000
# Block the on-chain salt/event lookups start from (set to the TREX factory deploy block
# to avoid scanning Sepolia from genesis on each reconcile). 0 = from genesis.
TREX_FACTORY_START_BLOCK=0
# Earliest block where a platform investor ONCHAINID could have emitted a claim. The global claim
# indexer uses this only on its first checkpoint; zero falls back to TREX_FACTORY_START_BLOCK or
# one chunk behind the current safe head.
CLAIM_INDEXER_START_BLOCK=0
REGISTRY_INDEXER_START_BLOCK=0
# Salt-reconcile event scan tuning: blocks per eth_getLogs window (keep under the RPC
# provider's range cap, e.g. 9000 for a 10k limit) and max lookback when no start block set.
RECONCILE_BLOCK_OFFSET=9000
RECONCILE_MAX_LOOKBACK_BLOCKS=1000000
# Deployment-attempt flow. Sepolia chain id is 11155111.
BLOCKCHAIN_CHAIN_ID=11155111
# Comma-separated list of chain ids the deployment flow accepts.
SUPPORTED_CHAIN_IDS=11155111
BLOCKCHAIN_NETWORK_NAME=sepolia
# Minutes a pending (pre-broadcast) deployment attempt stays valid before it expires.
DEPLOYMENT_ATTEMPT_TTL_MINUTES=20
# Master switch for the background TREX deployment-sync runner. Set false to disable it
# regardless of the TrexDeploymentSyncEnabled general setting. Runner tuning (interval,
# block offset, confirmations, checkpoint) lives in the generalSettings table.
TREX_DEPLOYMENT_SYNC_ENABLED=true

# Investor token purchases. The address below is the current Sepolia USDT contract and must
# be replaced per network. The backend verifies transfers and the platform agent mints tokens.
PURCHASE_USDT_ADDRESS=0x8fC7e68897bd74c4B6340d2DC857a7ED2677aF6A
# Successful receipt confirmations required by the interactive confirm API before it submits mint.
PURCHASE_PAYMENT_CONFIRMATIONS=2
# Final mint confirmation threshold.
PURCHASE_CONFIRMATIONS=2
# Minutes before a PENDING_PAYMENT intent with no submitted transaction hash expires.
PURCHASE_INTENT_TTL_MINUTES=15
PURCHASE_INDEXER_START_BLOCK=0
PURCHASE_WORKER_ENABLED=false

# Manual issuer-funded redemption. The issuer pays USDT, while the platform Token Agent
# locks and burns ERC-3643 tokens.
REDEMPTION_USDT_ADDRESS=0x8fC7e68897bd74c4B6340d2DC857a7ED2677aF6A
TRANSACTION_INDEXER_ENABLED=true
# Set this to the Platform Controller deployment block in production. Zero falls back to the earliest deployed token block.
TRANSACTION_INDEXER_START_BLOCK=0
TRANSACTION_INDEXER_CONFIRMATIONS=2
REDEMPTION_CONFIRMATIONS=2
REDEMPTION_AUTHORIZATION_TTL_MINUTES=30
REDEMPTION_INDEXER_START_BLOCK=0
REDEMPTION_WORKER_ENABLED=false

# Investor-to-investor ERC-3643 token transfers.
TRANSFER_CONFIRMATIONS=2
TRANSFER_INDEXER_CONFIRMATIONS=2
TRANSFER_INTENT_TTL_MINUTES=15
TRANSFER_INDEXER_START_BLOCK=0
TRANSFER_WORKER_ENABLED=false

ADMIN_FULL_NAME=T-REX Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceMe123!
ADMIN_ROLE_UID=00000000-0000-4000-8000-000000000001
