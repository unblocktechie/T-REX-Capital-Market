    {
      "name": "General Settings",
      "item": [
        {
          "name": "Get Public Settings",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/general-settings/public" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Public settings are returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Create General Setting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"settingKey\": \"application.pageSize.{{$timestamp}}\",\n  \"settingValue\": \"25\",\n  \"valueType\": \"number\",\n  \"settingGroup\": \"application\",\n  \"description\": \"Default frontend page size\",\n  \"isPublic\": true,\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/general-settings"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Setting is created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.data) pm.collectionVariables.set('settingUid', json.data.settingUid);"] } }]
        },
        {
          "name": "List General Settings",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/general-settings?page=1&limit=20&search=pageSize&sortBy=settingKey&sortOrder=asc&settingGroup=application&valueType=number&isPublic=true&isActive=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Settings are listed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get General Setting By UID",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/general-settings/{{settingUid}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Setting is returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update General Setting",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"settingValue\": \"50\",\n  \"description\": \"Updated default frontend page size\",\n  \"isPublic\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/general-settings/{{settingUid}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Setting is updated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Delete General Setting",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/general-settings/{{settingUid}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Setting is soft-deleted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
