    {
      "name": "Permission Management",
      "item": [
        {
          "name": "Create Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleUid\": \"{{adminRoleUid}}\",\n  \"menuUid\": \"{{usersMenuUid}}\",\n  \"permissionName\": \"Access sample API\",\n  \"permissionCode\": \"SAMPLE_API_{{$timestamp}}\",\n  \"httpMethod\": \"GET\",\n  \"apiPath\": \"/api/v1/sample/{{$timestamp}}\",\n  \"isAllowed\": true,\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/permissions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Permission is created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.data) pm.collectionVariables.set('permissionUid', json.data.permissionUid);"] } }]
        },
        {
          "name": "List Permissions",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/permissions?page=1&limit=20&search=sample&sortBy=permissionName&sortOrder=asc&roleUid={{adminRoleUid}}&httpMethod=GET&isAllowed=true&isActive=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Permissions are listed', () => pm.response.to.have.status(200));"] } }]
