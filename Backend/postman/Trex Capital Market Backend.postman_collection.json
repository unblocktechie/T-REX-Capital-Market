            "url": "{{baseUrl}}/api/v1/roles/{{roleUid}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Role is updated', () => pm.response.to.have.status(200));"] } }]
