        {
          "name": "List Roles",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/roles?page=1&limit=20&search=Operations&sortBy=roleName&sortOrder=asc&isSystem=false&isActive=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Roles are listed', () => pm.response.to.have.status(200));"] } }]
