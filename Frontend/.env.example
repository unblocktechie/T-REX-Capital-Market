VITE_TREX_GATEWAY_ADDRESS=0x9b0077e6000C9937eE769A61519F9CdFc3f30331
VITE_TREX_PLATFORM_WALLET_ADDRESS=0x849F887daec1B14c161ec377C95549ef83dDf3ff
