        {
          "name": "Delete Role",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/roles/{{roleUid}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Role is soft-deleted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Menu Management",
