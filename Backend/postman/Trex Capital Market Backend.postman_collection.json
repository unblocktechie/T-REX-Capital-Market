          "name": "Update Menu",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"menuName\": \"Token Launches\",\n  \"displayOrder\": 15,\n  \"isVisible\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/menus/{{menuUid}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Menu is updated', () => pm.response.to.have.status(200));"] } }]
