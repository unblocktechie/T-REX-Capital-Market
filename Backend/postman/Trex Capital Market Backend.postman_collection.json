            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"parentMenuUid\": null,\n  \"menuName\": \"Launches {{$timestamp}}\",\n  \"menuCode\": \"LAUNCHES_{{$timestamp}}\",\n  \"routePath\": \"/launches\",\n  \"icon\": \"rocket\",\n  \"displayOrder\": 10,\n  \"isVisible\": true,\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/menus"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Menu is created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.data) pm.collectionVariables.set('menuUid', json.data.menuUid);"] } }]
        },
        {
          "name": "List Menus",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/menus?page=1&limit=20&search=Launches&sortBy=displayOrder&sortOrder=asc&isVisible=true&isActive=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Menus are listed', () => pm.response.to.have.status(200));"] } }]
        },
