VITE_WALLET_VIEW_NATIVE_CURRENCY_NAME=Sepolia Ether
VITE_WALLET_VIEW_NATIVE_CURRENCY_SYMBOL=ETH
VITE_WALLET_VIEW_NATIVE_CURRENCY_DECIMALS=18
VITE_WALLET_VIEW_RPC_URL=https://11155111.rpc.thirdweb.com
VITE_WALLET_VIEW_EXPLORER_NAME=Etherscan
VITE_WALLET_VIEW_EXPLORER_URL=https://sepolia.etherscan.io
VITE_WALLET_VIEW_EXPLORER_API_URL=https://api-sepolia.etherscan.io/api
