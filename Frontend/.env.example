# Example/default browser-safe configuration (Arc Testnet).
# This preserves the existing Arc Testnet behavior for `npm run dev` and
# the common `npm run build` command.
#
# SECURITY: every VITE_* value is bundled into browser code. Never place
# private keys, signing keys, passwords, server API secrets, or other secrets here.

# Application
VITE_APP_NAME=T-REX Capital Market
VITE_APP_VERSION=1.0.0
VITE_APP_DEFAULT_LOCALE=en-IN
VITE_APP_DEFAULT_CURRENCY=USD
VITE_APP_DEFAULT_PAGE_SIZE=10

# Branding / UI
VITE_COMPANY_NAME=T-REX Capital Market
VITE_SHORT_PRODUCT_NAME=T-REX
VITE_BRAND_SUBTITLE=Capital Market
VITE_SUPPORT_EMAIL=support@trexcapitalmarket.dev
VITE_COMPLIANCE_EMAIL=compliance@erc3643.com
VITE_COMPANY_WEBSITE_URL=https://unblocktechnolabs.com/
VITE_COMPANY_WEBSITE_LABEL=Unblock Technolabs
VITE_META_DESCRIPTION=T-REX Capital Market for compliant digital securities, identity verification and token lifecycle management
VITE_BROWSER_THEME_COLOR="#d5d9dd"
VITE_FAVICON_PATH=/favicon.ico
VITE_FAVICON_32_PATH=/favicon-32.png
VITE_APPLE_TOUCH_ICON_PATH=/apple-touch-icon.png

# API / socket
VITE_API_BASE_URL=https://trex-api.unblocktechnolabs.com/api
VITE_API_VERSION=v1
VITE_SOCKET_URL=ws://192.168.29.90:3000/ws
VITE_REQUEST_TIMEOUT=500000

# Build / dev server
VITE_DEV_PORT=5173
VITE_DEV_HOST=true
VITE_DEV_OPEN_BROWSER=true
VITE_DEV_ALLOWED_HOSTS=gullible-borrower-recreate.ngrok-free.dev
VITE_PREVIEW_PORT=4173
VITE_PREVIEW_HOST=true
VITE_ENABLE_SOURCEMAPS=false
VITE_BUILD_TARGET=es2022
VITE_ENABLE_CSS_CODE_SPLITTING=true
VITE_CHUNK_SIZE_WARNING_LIMIT_KB=850

# Feature flags
VITE_USE_MOCK_API=false
VITE_ENABLE_DARK_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_USER_MANAGEMENT=true
VITE_ENABLE_AUDIT_TRAIL=false
VITE_ENABLE_CONTACT_SUPPORT_ACTIONS=false
VITE_ENABLE_MAINNET_LAUNCH_BANNER=true
VITE_MAINNET_LAUNCH_BANNER_MESSAGE=T-REX Capital Market is now live on Mainnet.
VITE_MAINNET_LAUNCH_BANNER_CTA=Read the announcement
VITE_MAINNET_LAUNCH_BANNER_URL=https://your-domain.example/mainnet-announcement

# Optional browser integrations
VITE_FIREBASE_API_KEY=
VITE_SENTRY_DSN=

# Privy authentication + embedded wallet configuration
VITE_PRIVY_APP_ID=cmtqzuudp01340cl7inmrtbj8
VITE_PRIVY_CLIENT_ID=
# Enable "Return user data in an identity token" in Privy Dashboard ->
# User management -> Authentication -> Advanced.

# Arc Testnet - transaction-critical network
VITE_ARC_NETWORK_KEY=arc
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_NETWORK_NAME=Arc
VITE_ARC_NETWORK_SHORT_NAME=Arc
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
VITE_ARC_RPC_WS_URL=wss://rpc.testnet.arc.network
VITE_ARC_EXPLORER_NAME=ArcScan
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app
VITE_ARC_NETWORK_ICON_URL=https://testnet.arcscan.app/assets/configs/network_icon.svg
VITE_ARC_IS_TESTNET=true
VITE_ARC_ENVIRONMENT_LABEL=Testnet
VITE_ARC_NATIVE_CURRENCY_NAME=USD Coin
VITE_ARC_NATIVE_CURRENCY_SYMBOL=USDC
VITE_ARC_NATIVE_CURRENCY_DECIMALS=18
VITE_REQUIRED_TRANSACTION_CONFIRMATIONS=1

# Secondary wallet-view / bridge network (existing Sepolia behavior)
VITE_WALLET_VIEW_NETWORK_KEY=ethereum-sepolia
VITE_WALLET_VIEW_CHAIN_ID=11155111
VITE_WALLET_VIEW_NETWORK_NAME=Ethereum Sepolia
VITE_WALLET_VIEW_NETWORK_SHORT_NAME=Sepolia
