  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Unversioned health endpoint. Returns status, uptime, environment, UTC timestamp, and version."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API is healthy', function () {",
            "  pm.response.to.have.status(200);",
            "  const json = pm.response.json();",
            "  pm.expect(json.success).to.eql(true);",
            "  pm.expect(json.data.status).to.eql('UP');",
            "});"
          ] } }]
        },
        {
          "name": "Versioned Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Authentication",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Signup (Issuer Example)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const email = `ada.lovelace.${Date.now()}@example.com`;",
              "pm.collectionVariables.set('signupEmail', email);"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Account is created', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.email).to.eql(pm.collectionVariables.get('signupEmail'));",
              "  pm.expect(json.data.roleUid).to.eql(pm.collectionVariables.get('issuerRoleUid'));",
              "  pm.expect(json.data).not.to.have.property('passwordHash');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Ada Lovelace\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\",\n  \"isIssuer\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/signup",
            "description": "Generates a unique sample email, assigns the Issuer role, and sends the verification email. Set isIssuer to false to test Investor assignment."
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{signupEmail}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/resend-verification"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Request is accepted', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/verify-email?token={{verificationToken}}",
            "description": "Copy the latest token from the verification email into verificationToken before sending."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Email is verified', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.emailVerified).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('User login succeeds', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) pm.collectionVariables.set('userToken', json.data.accessToken);"
          ] } }]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Run after npm run seed:admin. Automatically saves adminToken for every protected request."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.expect(json.data.accessToken).to.be.a('string');",
            "pm.collectionVariables.set('adminToken', json.data.accessToken);"
          ] } }]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{signupEmail}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Reset email request succeeds for registered user', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Verify Reset Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/verify-reset-token?token={{resetToken}}",
            "description": "Copy the token from the password-reset email into resetToken before sending."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Reset token is valid', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.valid).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Password is reset', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Login With New Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('New password works', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) pm.collectionVariables.set('userToken', json.data.accessToken);"
          ] } }]
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Create User",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('managedUserEmail', `grace.hopper.${Date.now()}@example.com`);"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('User is created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json.data) pm.collectionVariables.set('managedUserUid', json.data.userUid);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleUid\": \"{{investorRoleUid}}\",\n  \"fullName\": \"Grace Hopper\",\n  \"email\": \"{{managedUserEmail}}\",\n  \"password\": \"Compiler!123\",\n  \"emailVerified\": true,\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users?page=1&limit=20&search=Grace&sortBy=fullName&sortOrder=asc&roleUid={{investorRoleUid}}&emailVerified=true&isActive=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Users are listed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().meta.pagination).to.be.an('object');"] } }]
        },
        {
          "name": "Get User By UID",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users/{{managedUserUid}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User is returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Rear Admiral Grace Hopper\",\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/users/{{managedUserUid}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User is updated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/users/{{managedUserUid}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User is soft-deleted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
