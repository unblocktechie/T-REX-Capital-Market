# --- Per-network RPC URLs (see networks.json) ---
# networks.json maps a network name to the env var names holding its RPC
# URL / deployer key. Adding a new chain: add an entry to networks.json,
# then set its rpcUrlEnv var here, e.g. ARC_TESTNET_RPC_URL=... . Then run
# `npm run deploy:chain -- --network <name>` to deploy platform contracts +
# compliance modules + platform controller in one go.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Free API key from https://etherscan.io/myapikey — used by `npm run verify:chain`
# (see scripts/verify-chain.ts) to verify deployed contracts on the explorer.
# Used as the default for every network unless that network's networks.json
# entry sets its own explorerApiKeyEnv pointing at a different var here (e.g.
# for a network on a different, non-Etherscan explorer).
ETHERSCAN_API_KEY=
# Arc Testnet's explorer (Blockscout) — verification works without a real key,
# but hardhat-verify requires the field to be non-empty. Any placeholder string is fine.
ARC_TESTNET_EXPLORER_API_KEY=any

# --- Issuer suite deployment (phase0-02-deploy-issuer-suite.ts) ---
ISSUER_ADDRESS=
ISSUER_PRIVATE_KEY=

# --- TREXPlatformController (deploy-platform-controller.ts / wire-platform-controller.ts) ---
# Comma-separated ERC-20 contract addresses to whitelist as payment tokens
# at deploy time, e.g. "0xUSDT...,0xUSDC...". More can be added later via
# add-payment-token.ts, from the owner wallet, with no redeploy.
PAYMENT_TOKEN_ADDRESSES=
# Optional: platform controller owner, defaults to DEPLOYER_PRIVATE_KEY's address.
PLATFORM_OWNER_ADDRESS=
# Only needed when running wire-platform-controller.ts for a specific token.
TOKEN_ADDRESS=
INITIAL_PRICE=

# --- add-payment-token.ts (whitelist/remove a payment token post-deploy) ---
# Controller owner's wallet — the only key that can add/remove payment tokens.
PLATFORM_OWNER_PRIVATE_KEY=
PAYMENT_TOKEN_ADDRESS=
# Optional: "add" (default) or "remove".
ACTION=
