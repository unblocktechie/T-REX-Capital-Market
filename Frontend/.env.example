VITE_APP_NAME=T-REX Capital Market
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://192.168.29.90:3000/api
VITE_API_VERSION=v1
VITE_SOCKET_URL=ws://192.168.29.90:3000/ws
VITE_REQUEST_TIMEOUT=15000
VITE_USE_MOCK_API=false
VITE_ENABLE_DARK_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SOURCEMAPS=false
VITE_FIREBASE_API_KEY=
VITE_SENTRY_DSN=
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# Privy authentication + embedded wallet configuration
# App ID is public and is used by the browser SDK. Client ID is optional.
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_PRIVY_CLIENT_ID=
# Enable "Return user data in an identity token" in Privy Dashboard -> User management -> Authentication -> Advanced.

# Privy embedded wallets are restricted to Sepolia for the current platform.
VITE_WEB3_DEFAULT_CHAIN=sepolia
VITE_WEB3_ENABLED_CHAINS=sepolia
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Public Sepolia T-REX deployment contracts
VITE_TREX_GATEWAY_ADDRESS=0x32c06Dcd426ee86c4FDD2514c58785ff7A5DDAc0
# This platform wallet is always included as a Token Agent so the platform can
# perform approved token operations, such as minting on behalf of the issuer.
VITE_TREX_PLATFORM_WALLET_ADDRESS=0xDbBdcA99d568B54feaAb6c6D34e8f0093c509859
VITE_TREX_PLATFORM_CONTROLLER_ADDRESS=0x40e81FAA4e6D54ae0632DF146939bB5858359271
VITE_TREX_PAYMENT_TOKEN_ADDRESS=0x86B14D29A59b745bF08c42661322d13142d5eb49
VITE_ONCHAIN_ID_FACTORY_ADDRESS=0xe1da45b88C9d3f4347A6E1C6e8ee63e360068a15
VITE_COUNTRY_RESTRICT_MODULE_ADDRESS=0xF5D3F29B57f2fd33aDbF5d6A5F5C774C07D18fDf
VITE_MAX_BALANCE_MODULE_ADDRESS=0x45747f7068CE9C743b82ec3E8E92627b495860A6
VITE_MAX_INVESTORS_MODULE_ADDRESS=0xa729d37329Bc0F513d5E50d200ec9cf06a80064F

# Never put deployer or issuer private keys in a VITE_* variable or frontend source.
# The issuer signs deployment transactions through the authenticated Privy embedded wallet.
